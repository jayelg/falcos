# syntax=docker/dockerfile:1.25.0@sha256:0adf442eae370b6087e08edc7c50b552d80ddf261576f4ebd6421006b2461f12
# The above line is a parser directive, so it must stay the first line of the file and of
# the generated one for buildx builder in CI and local builds compute the same cache keys.
# Buildah ignores the directive
#
# The build Containerfile is generated by scripts/build.sh from the
# skeleton at scripts/Containerfile.skeleton. The section between the
# BEGIN/END GENERATED markers comes from build-phases/ and the image,
# via scripts/gen-containerfile.sh.
#
# Paths are relative to the build context root, not to the skeleton.
FROM scratch AS ctx
COPY build-phases/ /
COPY lib/ /lib/
COPY modules/ /modules/
COPY brand/ /brand/

# ---- BEGIN GENERATED (build phases and modules; see scripts/gen-containerfile.sh) ----
#
# Empty here on purpose. The base image FROM, one RUN layer per
# build-phases/*.sh and one per module the image lists are spliced in between
# these markers, along with the ARGs they read, and the result is written
# to containerfiles/<image>.generated, one per image, which is what
# actually builds and is committed. To change what the image contains or
# what it builds on, edit the image's own .kdl or drop a script in build-phases/,
# not this file.
#
# The region starts above the FROM rather than below it because the base
# image is declared by the image now. Keeping the FROM out here would
# have meant either a second place naming the image or a generator that
# rewrites a line it does not own.
#
# ---- END GENERATED ----

### LINTING
## Verify final image and contents are correct. Every check here is a
## pre-publish gate: a failure stops the image before it is signed and
## pushed to the tag users track.
## Bind mounted and run through bash, the way every module layer runs, so
## the validator needs no execute bit and leaves nothing in the image.
##
## CONTRACT_FILES is every provides-file the enabled modules declare,
## resolved on the host by scripts/build.sh and passed in, so no list of
## module-owned paths is written down in lib. Empty is a valid build.
##
## VERIFY_EXCEPTIONS is every systemd-analyze verify diagnostic those
## modules accept on their own units, as <class>|<unit> tokens, resolved
## the same way and for the same reason. Only the class name travels: the
## pattern it stands for stays in lib/validate-image.sh, where it does not
## have to survive a build arg. Empty is a valid build, and the common one.
ARG CONTRACT_FILES=""
ARG VERIFY_EXCEPTIONS=""
RUN bootc container lint
RUN --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    CONTRACT_FILES="${CONTRACT_FILES}" \
    VERIFY_EXCEPTIONS="${VERIFY_EXCEPTIONS}" bash /ctx/lib/validate-image.sh
