# NVIDIA's libnvidia-container repo: the container toolkit, which the CUDA
# repo this image already draws the driver from does not carry. Left
# disabled; module.sh opts in for its one install.
#
# The repo's section id is nvidia-container-toolkit, which is the
# REPO_ID run-module.sh keys idempotency on. Stable, not experimental:
# the experimental channel moves on its own cadence and needs no
# capability the CDI path lacks.
REPO_ID="nvidia-container-toolkit"
source /ctx/lib/repo-helpers.sh

if [ ! -f /etc/yum.repos.d/${REPO_ID}.repo ]; then
	add_disabled_repo https://nvidia.github.io/libnvidia-container/stable/rpm/nvidia-container-toolkit.repo
fi
