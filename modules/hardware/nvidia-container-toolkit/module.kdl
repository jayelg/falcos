description "NVIDIA container toolkit and the CDI spec that makes the host driver available to containers"

supports "fedora"

// Needs the driver userspace present: nvidia-ctk reads the libraries and
// /sys to describe the card, and the spec it writes is worthless without
// a driver to point at. Depend on the capability, not the module name.
requires "nvidia-driver"

// The CDI spec every GPU container consumes. Written by this module's
// boot service, not at build time: the spec names the exact driver
// library filenames (libcuda.so.<version>), so one generated in a build
// container pins the build host's driver and goes stale -- failing every
// `--device nvidia.com/gpu=...` with "cannot stat libEGL_nvidia.so.<old>"
// -- the moment the runtime image's driver differs from it.
provides-file "/etc/cdi/nvidia.yaml"
