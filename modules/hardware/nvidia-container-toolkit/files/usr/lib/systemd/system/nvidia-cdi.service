[Unit]
Description=Generate the NVIDIA CDI spec from the live host driver
Documentation=man:nvidia-ctk(8)
# The toolkit is installed by the image; the modules-load config that
# brings up nvidia_drm/nvidia_uvm is the driver module's. Both must be
# present before nvidia-ctk can enumerate the card.
Requires=systemd-modules-load.service
After=systemd-modules-load.service
Before=podman.service
# The driver lives in the immutable /usr that bootc boots into, so a
# driver update is a new deployment and a reboot: this boot-time run
# always sees the driver the running system actually has. nvidia-ctk
# reads /sys/module/nvidia/version and the library filenames beside it,
# so the spec is a pure function of that driver. Nothing else needs to
# watch for changes.
ConditionPathExists=/dev/nvidiactl

[Service]
Type=oneshot
RemainAfterExit=yes
# Writes /etc/cdi/nvidia.yaml. The --output path is explicit because the
# default location varies by toolkit build, and the spec must land where
# podman/CDI looks (the CDI default search path includes /etc/cdi).
ExecStart=/usr/bin/nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml
# A failure here must not wedge boot: the box still works without
# containers, and the next boot (or a manual run) retries.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
