description "Xbox controller support via the xone driver, plus gamemode"

supports "fedora"

packages {
    fedora "gamemode"
}

// xone is a DKMS module: it needs kernel headers to build against, and
// the enrolled certificate to sign against. Declared as a capability
// rather than as kernel/cachyos-kernel, so swapping the kernel provider
// does not break this.
requires "kernel-devel"
requires-file "/usr/share/secureboot/sb_cert.der"
requires-file "/usr/libexec/kernel-devel-helpers.sh"

// The xone DKMS build targets, and signs for, whichever kernel variant
// the image ships, and the signing key arrives as a build secret.
arg "KERNEL"
secret "mok_privkey"

// xone publishes no releases, so the pin is a commit on its default
// branch. Nothing is downloaded: the build clones and checks out this
// commit, which is itself the content hash, so there is no url or sha256
// to declare.
asset "xone" {
    renovate datasource="git-refs" depName="https://github.com/medusalix/xone"
    version "3484f603484782dd7551c64e5a33fc602b127051"
}
