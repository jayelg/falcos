# Third-party repos, all left disabled: nothing else in the image may
# resolve from them, and this module opts in per install.
#
# The first REPO_ID names an id whose .repo file never carries that name,
# so run-module.sh's exists-check stays false and the guards below are the
# only idempotency -- which is what they are for.
REPO_ID="cuda-fedora44-x86_64"
source /ctx/lib/repo-helpers.sh

# NVIDIA's CUDA repo carries the driver at the one release the backend has
# an exact ABI and video-memory profile for. The multimedia repo's newer
# 615.78.08 has neither and oopses in nv_audio_dynamic_power when a
# display attached to the card goes through a modeset; see module.sh.
if [ ! -f /etc/yum.repos.d/cuda-fedora44.repo ]; then
	add_disabled_repo https://developer.download.nvidia.com/compute/cuda/repos/fedora44/x86_64/cuda-fedora44.repo
fi

# virt-preview tracks newer upstream QEMU releases for the current
# Fedora. Fedora 44's QEMU predates the vhost-user shared-memory protocol
# the device needs; see module.sh.
FEDORA_VER="$(rpm -E %fedora)"
if [ ! -f "/etc/yum.repos.d/virtmaint-sig-virt-preview-fedora-${FEDORA_VER}.repo" ]; then
	REPO_ID="copr:copr.fedorainfracloud.org:group_virtmaint-sig:virt-preview"
	add_disabled_repo "https://copr.fedoraproject.org/coprs/g/virtmaint-sig/virt-preview/repo/fedora-${FEDORA_VER}/virtmaint-sig-virt-preview-fedora-${FEDORA_VER}.repo"
fi
