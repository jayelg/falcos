description "Opinionated shell UX: eza, bat, ripgrep, fd, zoxide, starship, flyline, aichat and Nerd Fonts"

supports "fedora"

packages {
    fedora "bat" "eza" "fd-find" "gum" "ripgrep" "ugrep" "zoxide"
}

// Which Nerd Font families to install. A list, because the set is the
// whole point: one pin covers every family in the release, so adding or
// dropping one costs nothing but disk.
option "fonts" type="list" {
    description "Nerd Font families to install"
    default "0xProto" "CascadiaMono" "ComicShannsMono" "DroidSansMono" \
            "FiraCode" "Go-Mono" "IBMPlexMono" "JetBrainsMono" \
            "SourceCodePro" "Ubuntu"
}

// No official checksum published, so the hash is trust-on-first-use:
// taken at PR time, which still catches a release asset swapped after the
// pin was made.
asset "aichat" {
    renovate datasource="github-releases" depName="sigoden/aichat"
    version "0.30.0"
    url "https://github.com/sigoden/aichat/releases/download/v{version}/aichat-v{version}-x86_64-unknown-linux-musl.tar.gz"
    sha256 "6b0cc08c5ceb551dc52bfac2221752f82215be5908c70605d655e9b91ab1557c"
}

asset "starship" {
    renovate datasource="github-releases" depName="starship/starship"
    version "1.26.0"
    url "https://github.com/starship/starship/releases/download/v{version}/starship-x86_64-unknown-linux-musl.tar.gz"
    sha256 "b7c232b0e8249d8e55a40beb79c5c43a7d370f3f9408bd215deb0170daeaadf3" from="sidecar"
}

asset "flyline" {
    renovate datasource="github-releases" depName="HalFrgrd/flyline"
    version "1.3.0"
    url "https://github.com/HalFrgrd/flyline/releases/download/v{version}/libflyline-v{version}-x86_64-unknown-linux-gnu.tar.gz"
    sha256 "21bb0a7a0e417496ff68ef8379cadc05d35e42aee357fc64ad9a8d95f69320f8" from="sidecar"
}

// The pinned asset is the release's SHA-256.txt manifest, not a font
// archive: the build verifies the manifest against this hash and then
// each font against the manifest, so one pin covers every family the
// `fonts` option asks for.
asset "nerd-fonts" {
    renovate datasource="github-releases" depName="ryanoasis/nerd-fonts"
    version "3.4.0"
    url "https://github.com/ryanoasis/nerd-fonts/releases/download/v{version}/SHA-256.txt"
    sha256 "1f38c8463bd370edddcae7a4b346b42607c8168227eb0ff5b6b4c54bdf744389"
}
