#!/bin/sh
# Create a libvirt domain wired for virtio-nvgpu.
#
# Usage: nvgpu-create-vm NAME ISO
#
# The domain gets a 40 GiB qcow2 disk in the libvirt images pool and the
# device through nvgpu-add-vm; the installer boots from the ISO. The
# guest still needs the driver and NVIDIA's user-mode package, see the
# module README.
set -eu

die() {
	echo "nvgpu-create-vm: $*" >&2
	exit 1
}

name=${1:-}
iso=${2:-}
[ -n "$name" ] || { printf 'VM name: '; read -r name; }
[ -n "$iso" ] || { printf 'Installer ISO path: '; read -r iso; }
if [ -z "$name" ] || [ -z "$iso" ]; then
	die "usage: nvgpu-create-vm NAME ISO"
fi
case "$name" in
	'' | *[!A-Za-z0-9_.+-]*) die "the name may hold letters, digits, dot, dash, underscore and plus" ;;
esac
case "$name$iso" in
	*[\"\']*) die "quote characters are not supported in the name or the ISO path" ;;
esac
[ -f "$iso" ] || die "no ISO at $iso"
if virsh -c qemu:///system dominfo "$name" >/dev/null 2>&1; then
	die "domain $name already exists"
fi

images=/var/lib/libvirt/images
disk="$images/$name.qcow2"
[ -w "$images" ] || die "$images is not writable"
if [ ! -e "$disk" ]; then
	qemu-img create -q -f qcow2 "$disk" 40G
fi

xml=$(mktemp)
trap 'rm -f "$xml"' EXIT
cat >"$xml" <<EOF
<domain type='kvm'>
  <name>$name</name>
  <uuid>$(uuidgen)</uuid>
  <memory unit='MiB'>8192</memory>
  <currentMemory unit='MiB'>8192</currentMemory>
  <vcpu>4</vcpu>
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
    <boot dev='cdrom'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='host-passthrough' check='none'/>
  <clock offset='utc'/>
  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <devices>
    <disk type='file' device='disk'>
      <driver name='qemu' type='qcow2' discard='unmap'/>
      <source file='$disk'/>
      <target dev='vda' bus='virtio'/>
    </disk>
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='$iso'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
    </disk>
    <interface type='network'>
      <source network='default'/>
      <model type='virtio'/>
    </interface>
    <video>
      <model type='virtio'/>
    </video>
    <graphics type='spice' autoport='yes'>
      <listen type='address' address='127.0.0.1'/>
    </graphics>
    <input type='tablet' bus='usb'/>
    <memballoon model='virtio'/>
  </devices>
</domain>
EOF

virsh -c qemu:///system define "$xml" >/dev/null
"$(dirname "$0")/nvgpu-add-vm" "$name" || die "the domain was defined but the device was not added"
virsh -c qemu:///system start "$name" >/dev/null
echo "$name is booting the installer; open it in virt-manager for the console."
echo "The guest still needs the driver and the NVIDIA user-mode package, see the module README."
