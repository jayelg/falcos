#!/bin/bash
# libvirt hook: run a virtio-nvgpu backend for the VMs whose config
# attaches the device.
#
# The backend must already be listening when QEMU opens its chardev, so it
# is started here, in "prepare". `systemctl start` returns only once the
# unit's ExecStartPost has finished -- the socket exists, is mode 0777 and
# is labelled svirt_socket_t -- which is the state QEMU needs; anything
# short of that fails the start instead of letting QEMU hit a socket that
# is not ready for it. libvirt runs hooks as root, in the virtd_t domain:
# nothing in here may relabel or chmod (denied), the unit does that itself.
guest="$1"
op="$2"

case "$op" in
prepare | started)
	# Only guests using the device get a backend; every other domain is
	# none of this hook's business. The persistent config is read
	# straight off disk rather than through virsh dumpxml: this hook runs
	# inside libvirtd's domain job, and asking libvirtd for the same
	# domain back deadlocks the start (measured: hook and virsh both
	# blocked until killed).
	cfg="/etc/libvirt/qemu/${guest}.xml"
	[ -f "$cfg" ] || exit 0
	grep -q "vhost-user-test-device" "$cfg" || exit 0

	systemctl start "nvgpu@${guest}.service" || exit 1
	;;
stopped | release)
	systemctl stop "nvgpu@${guest}.service" || true
	;;
esac
exit 0
