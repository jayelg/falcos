#!/bin/bash
# libvirt hook: run a virtio-nvgpu backend for the VMs whose XML attaches
# the device, and make the socket one QEMU may connect to.
#
# The backend must already be listening when QEMU opens its chardev, so it
# is started in "prepare" and this hook waits for the socket before the VM
# is let through. QEMU runs as svirt_t, which the targeted policy lets
# connect to a socket it owns or one labelled for it -- and the service's
# socket lands as var_run_t, since nothing under /run carries a socket
# label of its own. chcon to svirt_socket_t is the fix, the same shape as
# the looking-glass relabel service. libvirt runs hooks as root.
guest="$1"
op="$2"

case "$op" in
prepare | started)
	# Only guests using the device get a backend; every other domain is
	# none of this hook's business. The persistent config is read
	# straight off disk rather than through virsh dumpxml: this hook runs
	# inside libvirtd's domain job, and asking libvirtd for the same
	# domain back deadlocks the start (measured: hook and virsh both
	# blocked until killed).
	cfg="/etc/libvirt/qemu/${guest}.xml"
	[ -f "$cfg" ] || exit 0
	grep -q "vhost-user-test-device" "$cfg" || exit 0

	systemctl start "nvgpu@${guest}.service" || exit 1
	sock="/run/nvgpu/${guest}.sock"
	for _ in $(seq 1 100); do
		[ -S "$sock" ] && break
		sleep 0.1
	done
	if [ ! -S "$sock" ]; then
		echo "nvgpu hook: ${sock} never appeared" >&2
		exit 1
	fi

	chcon -t svirt_socket_t "$sock"
	;;
stopped | release)
	systemctl stop "nvgpu@${guest}.service" || true
	;;
esac
exit 0
