description "NVIDIA GPU sharing across microVMs: the vhost-user-nvgpu backend and guest setup"

supports "fedora"

// The backend opens /dev/nvidia* and the host driver is the trust
// boundary this module shares. Depend on the driver, not on the module
// that happens to provide it.
requires "nvidia-driver"

// The backend is built here because upstream ships source only. The path
// is the contract with nvgpu@.service in this module's files/ overlay.
provides-file "/usr/libexec/nvgpu/vhost-user-nvgpu"

// The template unit every microVM starts. virtualization/nesbox names
// this path rather than the unit's name, so the provider can move.
provides-file "/usr/lib/systemd/system/nvgpu@.service"

// The backend starts before the nodes exist only if its unit can order
// against the one that makes them. hardware/nvidia owns that unit.
requires-file "/usr/lib/systemd/system/nvidia-nodes.service"

// Upstream tags releases but publishes no archives, so the tag is the
// pin: the checkout is its own integrity and there is no url or sha256 to
// declare. module.sh builds this tag; the guest setup script names the
// same release.
asset "virtio-nvgpu" {
    renovate datasource="github-tags" depName="nestrilabs/virtio-nvgpu"
    version "v0.2.1"
}
