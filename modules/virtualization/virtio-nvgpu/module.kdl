description "NVIDIA GPU sharing across VMs: the vhost-user-nvgpu backend and a SHMEM-capable QEMU"

supports "fedora"

// The host driver is hardware/nvidia: this module shares the card that
// driver owns, and needs the backend to open the nodes it created.
requires-file "/usr/share/secureboot/sb_cert.der"

// The backend is built here because upstream ships source only. The path
// is the contract with nvgpu@.service in this module's files/ overlay.
provides-file "/usr/libexec/nvgpu/vhost-user-nvgpu"

// Upstream publishes no releases or tags, so the pin is a commit, cloned
// and checked out: the commit is its own integrity, and there is no url or
// sha256 to declare. The pin is the tip of stock-qemu, the combined branch
// on the johngrantdev fork, with one branch per fix beside it until the
// series merges upstream; module.sh clones that branch. No local patch
// remains: the commit answers GET_SHMEM_CONFIG.
asset "virtio-nvgpu" {
    manual "upstream publishes no releases; pinned to a dev-branch commit"
    version "8908cd6e31e3c0609b4866b8fb122ebf357f9894"
}
