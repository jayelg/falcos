description "kvmfr DKMS kernel module, for Looking Glass frame relay from a passed-through GPU"

supports "fedora"

// kvmfr is a DKMS module, built and signed exactly like xone.
requires "kernel-devel"
requires-file "/usr/share/falcos/sb_cert.der"
requires-file "/usr/libexec/kernel-devel-helpers.sh"

// kvmfr is built and signed exactly like xone.
arg "KERNEL"
secret "mok_privkey"

// The kvmfr source is cloned at an upstream release tag, so nothing is
// downloaded and there is no url or sha256 to declare. The module's own
// version comes from that tag's dkms.conf rather than from a second pin
// here that could disagree with it.
asset "looking-glass" {
    renovate datasource="github-releases" depName="gnif/LookingGlass"
    version "B7"
}
