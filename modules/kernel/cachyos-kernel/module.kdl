description "CachyOS kernel and companions, with Secure Boot module signing"

supports "fedora"

// Anything building an out-of-tree kernel module needs the headers this
// installs, and the Secure Boot key material to sign the result with.
provides "kernel-devel"
provides-file "/usr/share/falcos/sb_cert.der"
provides-file "/usr/lib/falcos/kernel-package"

// The install and remove helpers for those headers, which lib/dkms-helpers.sh
// sources. This module's finalize hook removes it once every DKMS consumer
// has built, which is what `build-only` says: a contract between build
// layers rather than a file the finished image carries.
provides-file "/usr/libexec/kernel-devel-helpers.sh" build-only=#true

// The initramfs is built here, once, in this module's finalize hook. A
// module that needs a dracut module in it ships a dracut.modules naming
// it rather than rebuilding the initramfs itself.
//
// Building it at all needs the base image's dracut and its ostree
// integration, which is what `initramfs-generation` names. No module can
// provide that, so swapping the kernel is only possible on a base that
// declares it.
requires "initramfs-generation"
collects "dracut.modules" into="/usr/lib/falcos/dracut.modules"

// The kernel variant the fragment declares, and the optional MOK key the
// modules are signed with. The Secure Boot cert itself ships in this
// module's files/ overlay.
arg "KERNEL"
secret "mok_privkey"
