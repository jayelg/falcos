description "goojust, the OS TUI, plus the just engine and fastfetch it builds on"

supports "fedora"

// goojust reads one aggregated recipe file, so it owns where that file
// lives. Any module shipping a justfile.inc contributes to it; the
// runner learns the path from here rather than carrying it.
sink "justfile" file="justfile.inc" path="/usr/share/goojust/justfile.apps"
