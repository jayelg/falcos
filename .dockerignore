# Keeps the build context to what the build reads, and identical between a
# local build and CI, so a local build can reuse the CI layer cache (see
# scripts/build.sh). Anything listed here that appears under build-phases/,
# lib/ or modules/ would otherwise change the ctx stage and invalidate
# every module layer below it.
#
# Patterns match from the context root, so a nested directory needs the
# **/ prefix: __pycache__ alone would only exclude one at the root.
#
# Podman and buildah read .containerignore first and fall back to this
# file; BuildKit reads .dockerignore only. One file covers both.
.git
**/__pycache__
output
_build*
# Generated files, not build-phases/ which the pattern does not match
build
# modules/.remote is deliberately absent: it holds the out-of-tree
# modules image.kdl pins, fetched before the build, and their layers
# mount it out of the ctx stage like any other module.
# Tracked, so a checkout has it, and rewritten by every build. The
# frontend reads it as the dockerfile rather than out of the context, so
# excluding it costs nothing and keeps a regeneration off the ctx stage.
Containerfile.generated
# Host build tooling. Never copied into the image, and target/ is
# large enough that shipping it to the daemon is worth avoiding.
tools
