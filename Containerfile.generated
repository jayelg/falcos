    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    dnf5 install -y winetricks clinfo zstd 7zip && \
    ASSET_WINE_AFFINITY_VERSION="11.12" \
    ASSET_WINE_AFFINITY_URL="https://github.com/ryzendew/Affinity-Wine-Builder/releases/download/11.12/ElementalWarrior-wine-11.12.tar.xz" \
    ASSET_WINE_AFFINITY_SHA256="44a99f2a90356790936f08620ccca573581c0bb006b9bed6899dd4ed465986aa" \
    ASSET_DXVK_VERSION="3.0.1" \
    ASSET_DXVK_URL="https://github.com/doitsujin/dxvk/releases/download/v3.0.1/dxvk-3.0.1.tar.gz" \
    ASSET_DXVK_SHA256="bebb6284db590535b7b005c102ebf6850c98842cff0fded9aacb74babae14c49" \
    ASSET_VKD3D_PROTON_VERSION="3.0.1" \
    ASSET_VKD3D_PROTON_URL="https://github.com/HansKristian-Work/vkd3d-proton/releases/download/v3.0.1/vkd3d-proton-3.0.1.tar.zst" \
    ASSET_VKD3D_PROTON_SHA256="3cf2315522af5e43605ef6d3c41dad91387040bf97199934f3f7ab76caaa2f0c" \
    ASSET_WINDOWS_WINMD_VERSION="a4f924122bcdc1e65b94e882b5ea874cccad23bb" \
    ASSET_WINDOWS_WINMD_URL="https://github.com/microsoft/windows-rs/raw/a4f924122bcdc1e65b94e882b5ea874cccad23bb/crates/libs/bindgen/default/Windows.winmd" \
    ASSET_WINDOWS_WINMD_SHA256="d700ffb5733ffa4b3f58d8853636d195df72aa6ada1ae91651f4fdfeb55cc111" \
    ASSET_WINTYPES_SHIM_VERSION="f8a2d42ba3abc5dcdc584daa6728a2fa019be72e" \
    ASSET_WINTYPES_SHIM_URL="https://github.com/ElementalWarrior/wine-wintypes.dll-for-affinity/raw/f8a2d42ba3abc5dcdc584daa6728a2fa019be72e/wintypes_shim.dll.so" \
    ASSET_WINTYPES_SHIM_SHA256="a5cae5038f3f147a6e1e8973a1af097da38fe28869ebf1da94243d64bfebbff6" \
    ASSET_VC_REDIST_VERSION="14.44.35211" \
    ASSET_VC_REDIST_URL="https://download.visualstudio.microsoft.com/download/pr/9b0d1fa5-c16d-4ee8-97f0-c2734086ece8/CC0FF0EB1DC3F5188AE6300FAEF32BF5BEEBA4BDD6E8E445A9184072096B713B/VC_redist.x64.exe" \
    ASSET_VC_REDIST_SHA256="cc0ff0eb1dc3f5188ae6300faef32bf5beeba4bdd6e8e445a9184072096b713b" \
    ASSET_DOTNET48_URL="https://download.visualstudio.microsoft.com/download/pr/7afca223-55d2-470a-8edc-6a1739ae3252/abd170b4b0ec15ad0222a809b761a036/ndp48-x86-x64-allos-enu.exe" \
    ASSET_DOTNET48_SHA256="95889d6de3f2070c07790ad6cf2000d33d9a1bdfc6a381725ab82ab1c314fd53" \
    MODULE_COLLECT="justfile.inc=/usr/share/goojust/justfile.apps" bash /ctx/lib/run-module.sh /ctx/modules/apps/affinity

# ---- core/power-just-scripts ----
RUN --mount=type=bind,from=ctx,source=/modules/core/power-just-scripts,target=/ctx/modules/core/power-just-scripts \
    --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    MODULE_COLLECT="justfile.inc=/usr/share/goojust/justfile.apps" bash /ctx/lib/run-module.sh /ctx/modules/core/power-just-scripts

# ---- flavor gate ----
# Declared here rather than above: an ARG in scope is part of the cache
# key of every RUN below it, so every layer above this one is shared by
# every flavor and by the ungated build.
#
# No default, so an unset FLAVOR is the ungated set rather than a flavor
# nobody asked for. scripts/build.sh always passes one.
ARG FLAVOR

# ---- [desktop] ----
# ---- virtualization/vfio-passthrough ----
RUN --mount=type=bind,from=ctx,source=/modules/virtualization/vfio-passthrough,target=/ctx/modules/virtualization/vfio-passthrough \
    --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    FLAVOR_GATE=desktop bash /ctx/lib/run-module.sh /ctx/modules/virtualization/vfio-passthrough

# ---- [desktop] ----
# ---- virtualization/looking-glass ----
RUN --mount=type=bind,from=ctx,source=/modules/virtualization/looking-glass,target=/ctx/modules/virtualization/looking-glass \
    --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    --mount=type=secret,id=mok_privkey,target=/run/secrets/mok_privkey,required=false \
    ASSET_LOOKING_GLASS_VERSION="B7" \
    KERNEL=${KERNEL} FLAVOR_GATE=desktop bash /ctx/lib/run-module.sh /ctx/modules/virtualization/looking-glass

# ---- [laptop] ----
# ---- hardware/laptop-tweaks ----
RUN --mount=type=bind,from=ctx,source=/modules/hardware/laptop-tweaks,target=/ctx/modules/hardware/laptop-tweaks \
    --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    FLAVOR_GATE=laptop bash /ctx/lib/run-module.sh /ctx/modules/hardware/laptop-tweaks

# ---- finalize hook order ----
# Modules shipping a finalize.sh, in build order, resolved on the host.
ARG FINALIZE_ORDER="core/auto-updates kernel/cachyos-kernel"

# ---- image version ----
# The YYYYMMDD build date in CI. Below the modules because an ARG in
# scope is part of the cache key of every RUN under it, whether or not
# that RUN mentions it.
ARG IMAGE_VERSION=dev

# ---- phase 50-flavor.sh ----
RUN --mount=type=bind,from=ctx,source=/50-flavor.sh,target=/ctx/50-flavor.sh \
    --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/modules,target=/ctx/modules \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    FLAVOR=${FLAVOR} IMAGE_VERSION=${IMAGE_VERSION} FINALIZE_ORDER="${FINALIZE_ORDER}" /ctx/50-flavor.sh

# ---- phase 99-finalize.sh ----
RUN --mount=type=bind,from=ctx,source=/99-finalize.sh,target=/ctx/99-finalize.sh \
    --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/modules,target=/ctx/modules \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    FLAVOR=${FLAVOR} IMAGE_VERSION=${IMAGE_VERSION} FINALIZE_ORDER="${FINALIZE_ORDER}" /ctx/99-finalize.sh

# ---- END GENERATED ----

### SIGNING POLICY
## Bake cosign public key so bootc upgrade can verify signatures against it.
## The registries config and the policy.json merge live in the
## auto-updates module (files/ overlay + finalize.sh).
## Kept above LINTING so it's checked too.
COPY cosign.pub /etc/pki/containers/cosign.pub

### LINTING
## Verify final image and contents are correct. Every check here is a
## pre-publish gate: a failure stops the image before it is signed and
## pushed to the tag users track.
## Bind mounted and run through bash, the way every module layer runs, so
## the validator needs no execute bit and leaves nothing in the image.
##
## CONTRACT_FILES is every provides-file the enabled modules declare,
## resolved on the host by scripts/build.sh and passed in, so no list of
## module-owned paths is written down in lib. Empty is a valid build.
ARG CONTRACT_FILES=""
RUN bootc container lint
RUN --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    CONTRACT_FILES="${CONTRACT_FILES}" bash /ctx/lib/validate-image.sh
