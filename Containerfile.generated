    bash /ctx/lib/run-module.sh /ctx/modules/core/flatpak

# ---- core/brew ----
RUN --mount=type=bind,from=ctx,source=/modules/core/brew,target=/ctx/modules/core/brew \
    --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    --mount=type=cache,target=/var/cache \
