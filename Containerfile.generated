    MODULE_COLLECT="justfile.inc=/usr/share/goojust/justfile.apps" bash /ctx/lib/run-module.sh /ctx/modules/core/system-just-scripts

# ---- core/flatpak ----
RUN --mount=type=bind,from=ctx,source=/modules/core/flatpak,target=/ctx/modules/core/flatpak \
