# ---- core/cli-tools ----
RUN --mount=type=bind,from=ctx,source=/modules/core/cli-tools,target=/ctx/modules/core/cli-tools \
    --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    --mount=type=cache,target=/var/cache \
