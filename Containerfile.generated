FROM scratch AS ctx
COPY build-phases/ /
COPY lib/ /lib/
COPY modules/ /modules/

### Base Image
# Use major version tags with quay.io/fedora as old untagged manifests are pruned within days.
# Pinned fedora-bootc digest tags break Renovate.
FROM quay.io/fedora/fedora-bootc:44

## Build phases and modules: one RUN layer each for independent BuildKit
## caching. A phase is a build-phases/*.sh, ordered by its number around
## the module layers, which build at 50. A module runs through
## lib/run-module.sh (repo file, module.sh, SELinux policy, files overlay),
## with its asset pins and options already resolved into env.

# ---- BEGIN GENERATED (build phases and modules; see scripts/gen-containerfile.sh) ----

# ---- phase 00-setup.sh ----
RUN --mount=type=bind,from=ctx,source=/00-setup.sh,target=/ctx/00-setup.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    /ctx/00-setup.sh

# ---- base ----
RUN --mount=type=bind,from=ctx,source=/modules/base,target=/ctx/modules/base \
    --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    bash /ctx/lib/run-module.sh /ctx/modules/base

# ---- core/auto-updates ----
RUN --mount=type=bind,from=ctx,source=/modules/core/auto-updates,target=/ctx/modules/core/auto-updates \
    --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    MODULE_COLLECT="justfile.inc=/usr/share/goojust/justfile.apps" bash /ctx/lib/run-module.sh /ctx/modules/core/auto-updates

# ---- core/system-just-scripts ----
RUN --mount=type=bind,from=ctx,source=/modules/core/system-just-scripts,target=/ctx/modules/core/system-just-scripts \
    --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    --mount=type=cache,target=/var/cache \
