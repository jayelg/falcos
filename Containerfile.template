# syntax=docker/dockerfile:1.25.0@sha256:0adf442eae370b6087e08edc7c50b552d80ddf261576f4ebd6421006b2461f12
# The above line is a parser directive, so it must stay the first line of the file and of
# the generated one for buildx builder in CI and local builds compute the same cache keys.
# Buildah ignores the directive
#
# The build Containerfile is generated by scripts/build.sh
# The module section between the BEGIN/END MODULES markers is
# generated from modules.kdl by scripts/gen-containerfile.sh
FROM scratch AS ctx
COPY build-phases/ /
COPY lib/ /lib/
COPY modules/ /modules/

### Base Image
# Use major version tags with quay.io/fedora as old untagged manifests are pruned within days.
# Pinned fedora-bootc digest tags break Renovate.
FROM quay.io/fedora/fedora-bootc:44

### Kernel Build argument
# Don't update the below ARG for custom kernels.
# Kernels can be added as modules defined in modules.kdl.
# A kernel module overrides this value during the build.
ARG KERNEL=stock

RUN --mount=type=bind,from=ctx,source=/00-setup.sh,target=/ctx/00-setup.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    /ctx/00-setup.sh

## Modules: one RUN layer each for independent BuildKit caching, run
## through lib/run-module.sh (repo file, version pins, files overlay).

# ---- BEGIN MODULES (generated at build time from modules.kdl; see scripts/gen-containerfile.sh) ----
#
# Empty here on purpose: this file is the skeleton. One RUN layer per
# modules.kdl entry is spliced in between these markers and the result is
# written to Containerfile.generated, which is what actually builds and is
# committed beside this file. To change what the image contains, edit
# modules.kdl, not this file.
#
# ---- END MODULES ----

### Image Version Build Argument
# CI passes the YYYYMMDD build date to IMAGE_VERSION so this ARG sits below the modules so it
# doesn't invalidate the cache. It is defined here for the following RUN commands.
ARG IMAGE_VERSION=dev

RUN --mount=type=bind,from=ctx,source=/50-flavor.sh,target=/ctx/50-flavor.sh \
    --mount=type=bind,from=ctx,source=/lib/brand-helpers.sh,target=/ctx/lib/brand-helpers.sh \
    --mount=type=cache,target=/var/cache \
    --mount=type=cache,target=/var/log \
    --mount=type=tmpfs,target=/tmp \
    FLAVOR=${FLAVOR} IMAGE_VERSION=${IMAGE_VERSION} /ctx/50-flavor.sh

RUN --mount=type=bind,from=ctx,source=/99-finalize.sh,target=/ctx/99-finalize.sh \
    --mount=type=bind,from=ctx,source=/lib,target=/ctx/lib \
    --mount=type=bind,from=ctx,source=/modules,target=/ctx/modules \
    FLAVOR=${FLAVOR} FINALIZE_ORDER="${FINALIZE_ORDER}" /ctx/99-finalize.sh

### SIGNING POLICY
## Bake cosign public key so bootc upgrade can verify signatures against it.
## The registries config and the policy.json merge live in the
## auto-updates module (files/ overlay + finalize.sh).
## Kept above LINTING so it's checked too.
COPY cosign.pub /etc/pki/containers/cosign.pub

### LINTING
## Verify final image and contents are correct.
RUN bootc container lint
